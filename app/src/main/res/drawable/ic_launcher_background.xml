<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background: the dark diagonal gradient of the original artwork.
     Only the centre 72dp of the 108dp layer is visible, so the end colours are
     extrapolated to give #FF36383E -> #FF111216 across the visible area. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#FF3F4248"
        android:endColor="#FF08080C"
        android:type="linear" />
</shape>
